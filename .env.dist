# =============================================================================
# my-worker - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.dist .env
# Variable names and formats are parsed by neops_worker_sdk/config.py.

# -----------------------------------------------------------------------------
# Backend Connection
# -----------------------------------------------------------------------------

# URL of the workflow engine blackboard API (required).
# Default: the neops-lab local stack exposes the engine on localhost:3030.
URL_BLACKBOARD=http://localhost:3030

# -----------------------------------------------------------------------------
# Function Block Discovery
# -----------------------------------------------------------------------------

# Comma-separated list of directories to scan for function blocks
# (relative to the working directory, or absolute paths).
DIR_FUNCTION_BLOCKS=my_worker/fb

# -----------------------------------------------------------------------------
# Worker Registration
# -----------------------------------------------------------------------------

# Optional human-readable name for this worker instance.
WORKER_NAME=my-worker-dev

# Optional IP address of this worker.
# If not set, the backend won't know the worker's IP.
# (Keep it commented rather than empty: an empty string is still a value.)
# WORKER_IP_ADDRESS=

# Seconds to wait for a running job to complete during graceful shutdown.
# Default: 60
SHUTDOWN_TIMEOUT=60

# -----------------------------------------------------------------------------
# Intervals and Timeouts
# -----------------------------------------------------------------------------

# Heartbeat to the workflow engine (engine expects pings within 120s).
HEARTBEAT_INTERVAL=20
# Seconds between job poll requests.
POLL_INTERVAL=10
# Timeout in seconds for API requests to the workflow engine.
API_REQUEST_TIMEOUT=30

# Threshold in seconds for blocking operation detection warnings.
# Set to 0 to disable blocking detection. Default: 0.5
BLOCKING_DETECTION_THRESHOLD=0.5
